
# ----------------------------------------
# DISABLE DIRECTORY LISTING
# ----------------------------------------
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ----------------------------------------
    # BLOCK DIRECT ACCESS TO SENSITIVE DIRS
    # ----------------------------------------

    # Block app/ — PHP source, configs, helpers
    RewriteRule ^app(/.*)?$ - [F,L]

    # Block vendor/ — Composer packages
    RewriteRule ^vendor(/.*)?$ - [F,L]

    # Block storage/ — uploaded files must go through PHP controllers
    RewriteRule ^storage(/.*)?$ - [F,L]

    # ----------------------------------------
    # FAVICON — serve from public/dist/assets/img/
    # Browsers request these from the root path.
    # Must come BEFORE hotlink protection and
    # the catch-all /public rule.
    # ----------------------------------------
    RewriteRule ^favicon\.ico$ public/dist/assets/img/favicon.ico [L,NC]
    RewriteRule ^favicon-32x32\.png$ public/dist/assets/img/favicon-32x32.png [L,NC]
    RewriteRule ^favicon-16x16\.png$ public/dist/assets/img/favicon-16x16.png [L,NC]
    RewriteRule ^apple-touch-icon\.png$ public/dist/assets/img/apple-touch-icon.png [L,NC]

    # ----------------------------------------
    # HOTLINK PROTECTION
    # Allows blank referer (direct access) and
    # requests from the app's own domain only.
    # ----------------------------------------
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?localhost(/.*)?$ [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp|svg)$ - [F,NC,L]

    # ----------------------------------------
    # ROUTE ALL REQUESTS TO /public
    # ----------------------------------------
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>

# ----------------------------------------
# BLOCK SENSITIVE FILES
# ----------------------------------------

# .env — database credentials, app secrets
<Files ".env">
    Require all denied
</Files>

# Composer manifests, git config, editor config
<FilesMatch "^(composer\.(json|lock)|\.gitignore|\.gitattributes|\.editorconfig|phpunit\.xml)$">
    Require all denied
</FilesMatch>

# Block all dot-files (.git, .DS_Store, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Protect this file itself
<Files ".htaccess">
    Require all denied
</Files>

# ----------------------------------------
# LIMIT HTTP METHODS
# ----------------------------------------
<LimitExcept GET POST HEAD OPTIONS>
    Require all denied
</LimitExcept>

# ----------------------------------------
# SECURITY HEADERS
# ----------------------------------------
<IfModule mod_headers.c>

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"

    # Legacy XSS filter (IE/old Edge)
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer control
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict browser feature access
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), fullscreen=(self)"

    # Content Security Policy is now emitted dynamically from public/index.php
    # with a per-request nonce — do not set it here.

    # Cross-Origin headers
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "unsafe-none"

    # Enable HSTS only after HTTPS is fully configured and tested
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Remove server signature from responses
    Header always unset X-Powered-By
    Header always unset Server

</IfModule>

# ----------------------------------------
# MIME TYPES
# ----------------------------------------
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css               .css
    AddType image/svg+xml          .svg
    AddType image/webp             .webp
    AddType application/font-woff  .woff
    AddType font/woff2             .woff2
</IfModule>

# ----------------------------------------
# BROWSER CACHING — static assets only
# ----------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/font-woff     "access plus 1 year"
</IfModule>

# ----------------------------------------
# COMPRESSION — reduce transfer size
# ----------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain
</IfModule>

# ----------------------------------------
# CUSTOM ERROR PAGES
# ----------------------------------------
ErrorDocument 403 /public/index.php?url=errors/403
ErrorDocument 404 /public/index.php?url=errors/404
ErrorDocument 500 /public/index.php?url=errors/500
